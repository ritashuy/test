<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8">
  <title>未來方塊對對碰</title>
  <style>
    body {
      margin: 0;
      background: #0e0e0e;
      font-family: 'Orbitron', sans-serif;
      color: #00ffe7;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }
    .game-container {
      border: 3px solid #00ffe7;
      padding: 20px;
      background: #1c1c1c;
      border-radius: 15px;
      box-shadow: 0 0 20px #00ffe7;
      width: 400px;
    }
    .top-panel {
      display: flex;
      justify-content: space-between;
      margin-bottom: 20px;
    }
    .info-block {
      background: #222;
      padding: 10px 15px;
      border-radius: 8px;
      box-shadow: inset 0 0 5px #00ffe7;
      text-align: center;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(6, 50px);
      grid-gap: 5px;
      justify-content: center;
    }
    .tile {
      width: 50px;
      height: 50px;
      background: #333;
      border-radius: 5px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      color: #fff;
      box-shadow: 0 0 8px rgba(0,255,255,0.4);
      cursor: pointer;
      transition: background 0.15s, box-shadow 0.15s;
      user-select: none;
    }
    .tile.selected {
      background: #00ffe7;
      color: #222;
      box-shadow: 0 0 15px #00ffe7;
    }
    .tile.matched {
      background: #1cffa3;
      color: #111;
      animation: pop 0.4s;
    }
    @keyframes pop {
      0% { transform: scale(1);}
      50% { transform: scale(1.2);}
      100% { transform: scale(1);}
    }
  </style>
</head>
<body>

<div class="game-container">
  <div class="top-panel">
    <div class="info-block">
      等級<br><strong id="level">1</strong>
    </div>
    <div class="info-block">
      剩餘時間<br><strong id="timer">4:58</strong>
    </div>
    <div class="info-block">
      分數<br><strong id="score">0</strong>
    </div>
  </div>
  
  <div class="grid" id="grid">
    <!-- Tiles generated by JS -->
  </div>
</div>
<script>
  // 基本設定
  const icons = ['🐸', '🦊', '🦉', '🐸', '🦊', '🦉', '🐶', '🦁', '🐼', '🐻', '🐸', '🦊'];
  let tileIcons = [];
  let selected = [];
  let lock = false;
  let score = 0;
  let matchedCount = 0;
  const gridSize = 6 * 4; // 6 cols x 4 rows
  let timer = 298; // 秒
  let timerInterval = null;

  // 產生配對陣列
  function shuffleIcons() {
    // 12對動物，24格，重複兩次
    let base = ['🐸','🦊','🦉','🐶','🦁','🐼','🐻','🦄','🦓','🐨','🦖','🦢'];
    let arr = base.concat(base);
    // 打亂
    for (let i=arr.length-1; i>0; i--) {
      let j = Math.floor(Math.random()*(i+1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }

  function drawGrid() {
    const grid = document.getElementById('grid');
    tileIcons = shuffleIcons();
    grid.innerHTML = '';
    for(let i=0; i<gridSize; i++) {
      const tile = document.createElement('div');
      tile.className = 'tile';
      tile.dataset.index = i;
      tile.innerHTML = '';
      tile.addEventListener('click', onTileClick);
      grid.appendChild(tile);
    }
  }

  function revealTile(idx) {
    const grid = document.getElementById('grid');
    const tile = grid.children[idx];
    tile.innerHTML = tileIcons[idx];
    tile.classList.add('selected');
  }

  function hideTile(idx) {
    const grid = document.getElementById('grid');
    const tile = grid.children[idx];
    tile.innerHTML = '';
    tile.classList.remove('selected');
  }

  function matchTile(idx) {
    const grid = document.getElementById('grid');
    const tile = grid.children[idx];
    tile.classList.remove('selected');
    tile.classList.add('matched');
    tile.innerHTML = tileIcons[idx];
  }

  function onTileClick(e) {
    if(lock) return;
    const idx = parseInt(e.currentTarget.dataset.index);
    const grid = document.getElementById('grid');
    const tile = grid.children[idx];
    if(tile.classList.contains('matched') || tile.classList.contains('selected')) return;
    revealTile(idx);
    selected.push(idx);
    if(selected.length === 2) {
      lock = true;
      const [a, b] = selected;
      if(tileIcons[a] === tileIcons[b]) {
        setTimeout(() => {
          matchTile(a);
          matchTile(b);
          score += 10;
          matchedCount += 2;
          document.getElementById('score').textContent = score;
          selected = [];
          lock = false;
          if(matchedCount === gridSize) {
            alert('恭喜完成！');
            clearInterval(timerInterval);
          }
        }, 350);
      } else {
        setTimeout(() => {
          hideTile(a);
          hideTile(b);
          selected = [];
          lock = false;
        }, 700);
      }
    }
  }

  function startTimer() {
    timerInterval = setInterval(() => {
      timer--;
      const min = String(Math.floor(timer/60)).padStart(1, '0');
      const sec = String(timer%60).padStart(2, '0');
      document.getElementById('timer').textContent = `${min}:${sec}`;
      if(timer <= 0) {
        clearInterval(timerInterval);
        alert('時間到！');
      }
    }, 1000);
  }

  // 初始化遊戲
  function init() {
    score = 0;
    matchedCount = 0;
    timer = 298;
    document.getElementById('score').textContent = '0';
    document.getElementById('timer').textContent = '4:58';
    drawGrid();
    startTimer();
  }

  window.onload = init;
</script>
</body>
</html>
